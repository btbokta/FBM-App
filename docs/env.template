# POC environment template (stands in for .env.example, which the permission settings block).
# Copy to .env in the repo root (gitignored): cp docs/env.template .env && chmod 600 .env
# Never commit .env, paste it into chat, or print it.
# Format: KEY=value, no quotes, no trailing spaces.
# Reference: docs/PLAN.md section 6, docs/PRE-CODING-CHECKLIST.md

# =============================================================================
# SECTION 1: YOU FILL THESE IN
# =============================================================================

# Preview org URL, e.g. https://acme-poc.oktapreview.com (P1-T1)
# No trailing slash, no "-admin". Must end in .oktapreview.com or the guard aborts.
OKTA_ORG_URL=
# Same value as OKTA_ORG_URL, typed again on purpose (the guard compares the two).
POC_EXPECTED_ORG_URL=
# Leave blank until the preflight runs, then paste the 00o... org ID it prints.
POC_EXPECTED_ORG_ID=
# Super Administrator SSWS API token (P1-T2). Carries its owner's full privileges.
OKTA_API_TOKEN=
# The super admin who will authorize the Workflows connections (00u... from the
# Directory > People URL). Never put this account in POC-ITP-Test.
OKTA_WF_CONNECTION_USER_ID=
# Test users are poc-itp-userNN@this-domain. Nothing is ever sent to them.
POC_USER_EMAIL_DOMAIN=example.com
# Public IP of your second network (phone hotspot) with /32, e.g. 203.0.113.7/32.
# Used by test T3 only. Needed before P3-T3 creates the network zone.
POC_DENY_ZONE_CIDR=
# Vercel access token (P1-T4). Name POC-FBM-Mock, 30-day expiry.
VERCEL_TOKEN=

# =============================================================================
# SECTION 2: DO NOT FILL. Generated or set by the executor.
# `npm run setup:secrets` (P0-T3) fills the empty ones; later tasks fill the rest.
# =============================================================================

# Harness service app (key from P0-T3, client ID copied from Terraform in P3-T6).
OKTA_HARNESS_CLIENT_ID=
OKTA_HARNESS_KEY_FILE=
OKTA_HARNESS_KEY_ID=

# Generated random secrets (P0-T3).
POC_USER_PASSWORD=
MOCK_TEST_API_KEY=
MOCK_VENDOR_API_KEY=
MOCK_GTR_STATIC_BEARER=
VERCEL_PROJECT_NAME=

# Mock app URL (P2-T5). Defaults to https://<VERCEL_PROJECT_NAME>.vercel.app.
MOCK_BASE_URL=

# Workflows flow IDs (P6-T5, P7-T4): numeric IDs from the flow URLs.
WF_RESPOND_FLOW_ID=
WF_RESPOND_BY_EMAIL_FLOW_ID=

# Test defaults (set in P0-T3).
POC_BURST_USER_COUNT=
GTR_AUTH_MODE=
POC_T6_MAX_SECONDS=
POC_T6_MEDIAN_SECONDS=
POC_OBSERVE_TIMEOUT_SECONDS=

# Branch switches (defaults set in P0-T3; changed only by the tasks named in the plan).
POC_ENABLE_CLIENT_CREDENTIALS=
POC_SOC_INCLUDE_RESPOND=
POC_FALLBACK_MODE=
